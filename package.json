{
  "name": "@jptecno/cli",
  "version": "0.5.0",
  "description": "CLI para criar projetos a partir dos templates da JP Tecno.",
  "license": "MIT",
  "keywords": [
    "cli",
    "scaffolding",
    "template",
    "generator",
    "jptecno",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jptecno/cli"
  },
  "bugs": {
    "url": "https://github.com/jptecno/cli/issues"
  },
  "homepage": "https://github.com/jptecno/cli#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "jp": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "prepare": "lefthook install",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:vendored-schemas": "node scripts/verify-vendored-schemas.mjs",
    "vendor:schemas": "node scripts/vendor-schemas.mjs",
    "check": "npm run verify:vendored-schemas && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "danger": "13.0.10",
    "lefthook": "2.1.10",
    "tsx": "^4.19.2",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}

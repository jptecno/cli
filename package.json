{
  "name": "@jptecno/cli",
  "version": "0.2.1",
  "description": "CLI para criar projetos a partir dos templates da JP Tecno.",
  "repository": {
    "type": "git",
    "url": "https://github.com/jptecno/cli"
  },
  "type": "module",
  "bin": {
    "jp": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
